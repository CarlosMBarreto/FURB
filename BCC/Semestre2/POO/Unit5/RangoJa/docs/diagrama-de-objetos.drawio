        <mxCell id="cho_n" value="Só está no cardápio: o pedido do Beto recusou o chopp (menor de idade)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
