        </mxCell>
        <mxCell id="pud_a" value="nome = &quot;Pudim&quot;&lt;br&gt;precoBase = 8.0 (por 100 g)&lt;br&gt;pesoGramas = 150" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="pud">
