        <!-- Pedidos -->
        <mxCell id="ped2" value="pedidoAna : Pedido" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ped2_a" value="numero = 2&lt;br&gt;finalizado = true" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="ped2">
          <mxGeometry y="26" width="220" height="54" as="geometry"/>
