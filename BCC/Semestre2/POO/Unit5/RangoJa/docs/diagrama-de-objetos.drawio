        <mxCell id="xis" value="xisSalada : Prato" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="230" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="xis_a" value="nome = &quot;Xis Salada&quot;&lt;br&gt;precoBase = 30.0&lt;br&gt;tamanho = 'M'" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="xis">
