        </mxCell>

        <!-- Membros de classe (static) -->
        <mxCell id="stat" value="Pedido (membros static)&lt;br&gt;proximoNumero = 3&lt;br&gt;TAXA_ENTREGA = 7.0&lt;br&gt;VALOR_FRETE_GRATIS = 100.0" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="590" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Ligações (links entre objetos) -->
        <mxCell id="e1" value="indicadoPor" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="beto" target="ana">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="cliente" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="ass" target="ana">
