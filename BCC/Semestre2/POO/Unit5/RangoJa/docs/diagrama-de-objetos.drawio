        <mxCell id="beto_a" value="nome = &quot;Beto Lima&quot;&lt;br&gt;email = &quot;beto@furb.br&quot;&lt;br&gt;idade = 17&lt;br&gt;saldoCashback = 3.9" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="beto">
          <mxGeometry y="26" width="230" height="89" as="geometry"/>
