        <mxCell id="ped1" value="pedidoBeto : Pedido" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ped1_a" value="numero = 1&lt;br&gt;finalizado = true" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="ped1">
          <mxGeometry y="26" width="220" height="54" as="geometry"/>
