        <mxCell id="ref_a" value="nome = &quot;Refri&quot;&lt;br&gt;precoBase = 6.0&lt;br&gt;volumeMl = 350&lt;br&gt;alcoolica = false" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="ref">
