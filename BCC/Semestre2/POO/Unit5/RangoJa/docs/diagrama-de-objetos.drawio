<mxfile host="app.diagrams.net">
  <diagram id="rangoja-objetos" name="Diagrama de objetos - App">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="titulo" value="Diagrama de objetos do RangoJá: estado no fim do App (exemplo com quantidade digitada = 2)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="5" width="900" height="30" as="geometry"/>
        </mxCell>

        <!-- Cobranças -->
        <mxCell id="ass" value="assinatura : AssinaturaClube" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ass_a" value="valorMensal = 19.9&lt;br&gt;meses = 12" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="ass">
          <mxGeometry y="26" width="230" height="54" as="geometry"/>
        </mxCell>

        <mxCell id="cen" value="central : CentralCobranca" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="50" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cen_a" value="cobrancas = lista com 3 Cobravel" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="cen">
          <mxGeometry y="26" width="220" height="44" as="geometry"/>
        </mxCell>

        <!-- Clientes -->
        <mxCell id="ana" value="ana : Cliente" style="swimlane;fontStyle=5;startSize=26;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="230" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ana_a" value="nome = &quot;Ana Souza&quot;&lt;br&gt;email = &quot;ana@furb.br&quot;&lt;br&gt;idade = 20&lt;br&gt;saldoCashback = 7.85" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;whiteSpace=wrap;" vertex="1" parent="ana">
          <mxGeometry y="26" width="230" height="89" as="geometry"/>
