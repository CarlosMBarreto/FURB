        <mxCell id="e4" value="cliente" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="ped1" target="beto">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="itens" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="ped2" target="ref">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="itens" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="ped2" target="xis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="itens" style="endArrow=open;endFill=0;html=1;" edge="1" parent="1" source="ped2" target="pud">
